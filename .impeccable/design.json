  "narrative": {
    "northStar": "The Engineering Viewing Desk",
    "overview": "A warm paper reading field meets a saturated cobalt inspection stage. Large, compact lettering establishes the engineer's identity; the project controls couple a visible software artifact with its implementation context. The same visual language continues through open ruled experience rows, research columns and a full cobalt contact spread.\n\nThe system is precise and direct, with asymmetric desktop composition and an image-first mobile flow. English and French share the hierarchy. This record describes the completed code-led build; no approved page composition supplied visual authority. Source truth is src/styles.css, src/App.jsx, src/Lower.jsx, built dist/index.html, and dist/assets/favicon.svg. Desktop and French mobile captures corroborate the composition. The prior Contact Sheet identity is superseded only in this redesign branch.",
    "keyCharacteristics": [
      "Warm paper and ink reading surfaces with full-strength cobalt activity planes.",
      "Monumental Menbere identity, readable Menbere prose and restrained DM Mono metadata.",
      "Asymmetric artifact inspection that becomes image-first on mobile.",
      "Open ruled chronology and research columns rather than enclosed reading cards.",
      "One brief artifact reveal, native selection states and visible keyboard focus."
    ],
    "rules": [
      {
        "name": "The Activity Plane Rule",
        "body": "Cobalt can fill the inspection and contact surfaces; on the paper reading field it marks identity, interaction and selection.",
        "section": "colors"
      },
      {
        "name": "The Reading Face Rule",
        "body": "Keep prose and controls in Menbere; reserve DM Mono for concise dates, stacks, counts and small technical annotations.",
        "section": "typography"
      },
      {
        "name": "The Inspection Order Rule",
        "body": "Mobile places the selected artifact before its implementation context and keeps the three project choices visible.",
        "section": "layout"
      },
      {
        "name": "The Artifact Depth Rule",
        "body": "Keep shadow elevation on the inspected software frame; open editorial content relies on type, space and rules.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use warm paper for reading and cobalt for the inspection and contact activity planes.",
      "Do keep Menbere prose readable and DM Mono metadata concise.",
      "Do preserve image-first mobile inspection and visible project choices.",
      "Do use open ruled reading rows and the artifact's single soft shadow.",
      "Do preserve visible focus, actual pressed states and reduced-motion behavior.",
      "Do keep capture labels, provenance and original-file access connected to the displayed artifact."
    ],
    "donts": [
      "Don't revive the superseded charcoal, orange or film-perforation identity in this branch.",
      "Don't turn screenshot-internal colors, shadows or device corners into portfolio tokens.",
      "Don't apply the preview crop to the full-size evidence gallery.",
      "Don't expand project stacks or dates into decorative terminal prose.",
      "Don't invent input fields, unimplemented control states or claims of verified project outcomes."
    ]
  }
